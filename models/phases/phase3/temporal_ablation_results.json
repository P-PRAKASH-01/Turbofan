      0,
      119
    ],
    "time_s_strictly_increasing_unique_per_scenario": true,
    "timestamp_utc_strictly_increasing_unique_per_scenario": true,
    "time_s_interval_seconds": 1.0,
    "timestamp_utc_interval_seconds": 1.0,
    "csv_row_order_verified_chronological_within_each_scenario": true,
    "processed_sensor_alignment_checked_at_csv_precision": true
  },
  "feature_definitions": {
    "experiment_A": {
      "name": "Phase 3A baseline",
      "feature_count": 29,
      "features": [
        "altitude_m",
        "ambient_temp_c",
        "ambient_pressure_pa",
        "air_density_kg_m3",
        "throttle_pct",
        "phase_ground_run",
        "phase_climb",
        "phase_cruise",
        "phase_descent",
        "rpm_meas",
        "rpm_missing",
