        "manifold_pressure_missing",
        "cht_c_meas",
        "cht_missing",
        "egt_c_meas",
        "egt_missing",
        "oil_temp_c_meas",
        "oil_temp_missing",
        "oil_pressure_kpa_meas",
        "oil_pressure_missing",
        "fuel_flow_kg_s_meas",
        "fuel_flow_missing",
        "power_kw_meas",
        "power_missing",
        "torque_nm_meas",
        "torque_missing",
        "vibration_rms_g_meas",
        "vibration_missing"
      ]
    },
    "experiment_B": {
      "name": "Phase 3A baseline plus temporal predictors",
      "feature_count": 69,
      "added_features_per_sensor": 4,
      "sensor_columns": {
        "rpm": "rpm_meas",
        "manifold_pressure": "manifold_pressure_pa_meas",
        "cht": "cht_c_meas",
        "egt": "egt_c_meas",
        "oil_temp": "oil_temp_c_meas",
        "oil_pressure": "oil_pressure_kpa_meas",
        "fuel_flow": "fuel_flow_kg_s_meas",
        "power": "power_kw_meas",
        "torque": "torque_nm_meas",
        "vibration": "vibration_rms_g_meas"
      },
      "rolling_window": {
        "length_samples": 5,
        "sampling_period_seconds": 1,
        "span_between_first_and_last_sample_seconds": 4,
        "statistic": "population standard deviation (ddof=0)",
        "window_positions": "t-5 through t-1; excludes current sample t"
      },
      "first_difference": {
        "formula": "x[t] - x[t-1]",
        "valid_when": "current and immediately previous measurements are both non-missing and time_s difference is exactly 1 second"
      },
      "rolling_standard_deviation": {
        "formula": "std(x[t-5], x[t-4], x[t-3], x[t-2], x[t-1]), ddof=0",
        "valid_when": "all five preceding measurements are non-missing and consecutive; current reading is not included"
      },
      "validity_flags": {
        "per_sensor": [
          "<channel>_diff_valid",
          "<channel>_rolling_std_valid"
        ],
        "value_1": "derived value is valid",
        "value_0": "warm-up, missing data, or non-consecutive time invalidates value"
      },
      "warmup": "For each scenario, difference is invalid at t=0. Rolling standard deviation is invalid for t=0..4. The next scenario starts fresh.",
      "missing_policy": "If either measurement needed by a difference is missing, difference=NaN and diff_valid=0. A rolling standard deviation is NaN and its validity flag is 0 unless every one of the five preceding measurements exists and is non-missing. No interpolation or cross-scenario fill is used. Model median imputation is fitted on training data only; the final test estimator refits the imputer on train plus validation.",
      "ordering": "For each scenario, sort by numeric time_s (stable mergesort); verify timestamp_utc order and unique values. Restore generated features by raw_row_index only for row alignment; identifiers/time are not predictors.",
      "future_data": "None. Difference uses t and t-1; rolling window uses only t-5..t-1."
    }
  },
  "feature_use_controls": {
    "feature_A_count": 29,
    "feature_B_count": 69,
    "identifiers_used_only_for_grouping_alignment_and_split_masks": true,
